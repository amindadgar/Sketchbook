{
    "include": [
        "src/ts/**/*"
    ],
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "declaration": true,
        "declarationDir": "build/types",
        "baseUrl": ".",
        "paths": {
            "cannon": [
                "src/lib/cannon/cannon"
            ]
        },
        "skipLibCheck": true,
        "types": [],
        "allowSyntheticDefaultImports": true
    }
}