server {
	# Substituted at startup by the nginx image's entrypoint
	listen ${PORT};
	server_name _;
	root /usr/share/nginx/html;
	index index.html;

	# The bundle is utf-8 and says so nowhere else, so a browser left to
	# guess renders anything non-ascii in it as mojibake
	charset utf-8;

	# The bundle is over a megabyte of text and compresses well. The models and
	# audio underneath are already compressed, so they're left alone.
	gzip on;
	gzip_min_length 1024;
	gzip_types application/javascript text/css text/html application/json image/svg+xml;

	location / {
		try_files $uri $uri/ =404;
	}

	# The one file that changes without a rebuild, so it must not be held
	location = /config.js {
		add_header Cache-Control "no-store";
	}

	# A cached service worker is one you can't replace on the next deploy
	location = /sw.js {
		add_header Cache-Control "no-store";
	}

	location = /manifest.webmanifest {
		default_type application/manifest+json;
	}

	# Models and sounds only change when a new image is built
	location /build/assets/ {
		expires 7d;
		add_header Cache-Control "public";
	}

	# Neither is in nginx's default map, so they'd go out as octet-stream
	location ~* \.glb$ {
		default_type model/gltf-binary;
		expires 7d;
		add_header Cache-Control "public";
	}

	location ~* \.wav$ {
		default_type audio/wav;
		expires 7d;
		add_header Cache-Control "public";
	}
}
